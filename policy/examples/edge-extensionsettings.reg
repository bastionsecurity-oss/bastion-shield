Windows Registry Editor Version 5.00

; Bastion Shield - force-install in Microsoft Edge (example). SPDX-License-Identifier: GPL-3.0-or-later
;
; BEFORE IMPORTING: replace <EDGE_ADDONS_ID> with the published store id of Bastion Shield.
; Edge uses toolbar_state (force_shown / default_shown / default_hidden, Edge 103+).
; The Edge Add-ons id differs from the Chrome Web Store id.
; Reference: https://learn.microsoft.com/deployedge/microsoft-edge-policies/extensionsettings
;
; This sets the ExtensionSettings policy (one REG_SZ JSON string). If your
; organisation already uses ExtensionSettings, merge the Bastion Shield entry
; into the existing JSON instead: only one ExtensionSettings value can apply.
; For production use Intune (docs/DEPLOYMENT-INTUNE.md); this file is meant
; for testing on a single machine. To undo, delete the ExtensionSettings
; value in regedit; the browser then uninstalls the extension.

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge]
"ExtensionSettings"="{\"<EDGE_ADDONS_ID>\":{\"installation_mode\":\"force_installed\",\"update_url\":\"https://edge.microsoft.com/extensionwebstorebase/v1/crx\",\"toolbar_state\":\"force_shown\"}}"
